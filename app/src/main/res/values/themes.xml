<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Organisateur" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/light_blue_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_blue_100</item>
        <item name="colorOnPrimaryContainer">@color/light_blue_900</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/indigo_500</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/indigo_100</item>
        <item name="colorOnSecondaryContainer">@color/indigo_900</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorOnBackground">#1E293B</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">#1E293B</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="bottomSheetDialogTheme">@style/Theme.Organisateur.BottomSheet</item>
    </style>

    <!-- ===== Écran Rappels ===== -->

    <style name="Widget.Organisateur.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
        <item name="trackDecorationTint">@color/switch_track_decoration_tint</item>
    </style>

    <style name="TextAppearance.Organisateur.Time" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TextAppearance.Organisateur.ScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Theme.Organisateur.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Organisateur.BottomSheet</item>
    </style>

    <style name="Widget.Organisateur.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.Organisateur.BottomSheet</item>
        <item name="backgroundTint">@color/surface_card</item>
        <item name="behavior_skipCollapsed">true</item>
    </style>

    <style name="ShapeAppearance.Organisateur.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Sans cet habillage, le sélecteur d'heure hérite de la palette Material par défaut
         (fond cyan, accents roses) et jure avec le reste de l'écran. -->
    <style name="ThemeOverlay.Organisateur.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">@color/accent_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent_indigo</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/accent_indigo</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_muted</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_subtle</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Widget.Organisateur.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent_indigo</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Organisateur.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Organisateur.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/danger</item>
        <item name="iconTint">@color/danger</item>
        <item name="rippleColor">@color/danger</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
