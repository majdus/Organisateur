<?xml version="1.0" encoding="utf-8"?>
<!-- Anneau de sélection d'une couleur de texte: dessiné autour de la pastille plutôt que
     sur elle, pour ne pas altérer la couleur qu'il désigne. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="2dp"
        android:color="@color/text_primary" />
</shape>
