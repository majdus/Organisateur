<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".Notes">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationContentDescription="@string/action_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/text_primary" />

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:text="@string/notes_title"
                android:textAppearance="@style/TextAppearance.Organisateur.ScreenTitle" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="24dp"
                android:paddingBottom="16dp"
                android:textAppearance="@style/TextAppearance.Organisateur.Summary"
                tools:text="Enregistré · 128 mots" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- La feuille d'écriture occupe tout ce qui reste: une note se rédige en pleine page,
         la barre de mise en forme reste ancrée sous elle. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_editor_surface"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:hint="@string/notes_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingExtra="6dp"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_subtle" />

        <LinearLayout
            android:id="@+id/format_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/btn_bold"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_format_toggle"
                android:clickable="true"
                android:contentDescription="@string/notes_format_bold"
                android:focusable="true"
                android:gravity="center"
                android:text="B"
                android:textColor="@color/format_toggle_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_italic"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_format_toggle"
                android:clickable="true"
                android:contentDescription="@string/notes_format_italic"
                android:focusable="true"
                android:gravity="center"
                android:text="I"
                android:textColor="@color/format_toggle_text"
                android:textSize="18sp"
                android:textStyle="italic" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/border_subtle" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/btn_color_black"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:contentDescription="@string/notes_color_black"
                        android:focusable="true">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_bg"
                            android:backgroundTint="#0F172A" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btn_color_red"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:contentDescription="@string/notes_color_red"
                        android:focusable="true">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_bg"
                            android:backgroundTint="#EF4444" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btn_color_blue"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:contentDescription="@string/notes_color_blue"
                        android:focusable="true">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_bg"
                            android:backgroundTint="#3B82F6" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btn_color_green"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:contentDescription="@string/notes_color_green"
                        android:focusable="true">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_bg"
                            android:backgroundTint="#10B981" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btn_color_orange"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:contentDescription="@string/notes_color_orange"
                        android:focusable="true">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_bg"
                            android:backgroundTint="#F59E0B" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btn_color_purple"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:contentDescription="@string/notes_color_purple"
                        android:focusable="true">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_bg"
                            android:backgroundTint="#8B5CF6" />
                    </FrameLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
