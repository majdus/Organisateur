<?xml version="1.0" encoding="utf-8"?>
<!-- La ligne d'ajout reste toujours sous les éléments non cochés: c'est le seul endroit où
     l'utilisateur a besoin de viser pour allonger sa liste. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="32dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_add"
        app:tint="@color/accent_notes" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/note_checklist_add_item"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />
</LinearLayout>
