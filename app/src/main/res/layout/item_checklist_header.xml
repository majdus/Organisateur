<?xml version="1.0" encoding="utf-8"?>
<!-- Séparateur des éléments cochés, repliable: une liste de courses à moitié faite garde ainsi
     à l'écran ce qui reste à prendre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="8dp"
        android:background="@color/border_subtle" />

    <LinearLayout
        android:id="@+id/checkedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/expandIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_expand_more"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/checkedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="3 éléments cochés" />
    </LinearLayout>
</LinearLayout>
