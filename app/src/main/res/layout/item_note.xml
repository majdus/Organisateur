<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/Widget.Organisateur.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="120dp"
    app:cardCornerRadius="20dp"
    app:rippleColor="#148B5CF6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            tools:text="Liste de courses" />

        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="6"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Pain, lait, œufs, café, farine et un peu de levure" />

        <!-- Aperçu des notes de type liste: les premiers éléments avec leur case, cochés barrés.
             Les lignes sont ajoutées par l'adaptateur et réutilisées d'une liaison à l'autre. -->
        <LinearLayout
            android:id="@+id/checklistPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/moreItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="+ 3 autres éléments"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            tools:text="Aujourd'hui" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
