<?xml version="1.0" encoding="utf-8"?>
<!-- Le fond de l'écran porte la couleur de la note: on voit ce qu'on choisit, comme sur la
     carte correspondante dans la liste. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/note_default"
    android:orientation="vertical"
    tools:context=".NoteEditor">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:menu="@menu/note_editor"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary" />

    <EditText
        android:id="@+id/noteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:saveEnabled="false"
        android:background="@android:color/transparent"
        android:fontFamily="sans-serif-medium"
        android:hint="@string/note_title_hint"
        android:imeOptions="actionNext"
        android:inputType="textCapSentences"
        android:letterSpacing="-0.02"
        android:maxLength="120"
        android:maxLines="2"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="22sp"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:saveEnabled="false"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:gravity="top|start"
        android:hint="@string/notes_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:lineSpacingExtra="6dp"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="16sp"
        tools:ignore="Autofill" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle" />

    <LinearLayout
        android:id="@+id/format_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/btn_bold"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_format_toggle"
            android:clickable="true"
            android:contentDescription="@string/notes_format_bold"
            android:focusable="true"
            android:gravity="center"
            android:text="B"
            android:textColor="@color/format_toggle_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_italic"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_format_toggle"
            android:clickable="true"
            android:contentDescription="@string/notes_format_italic"
            android:focusable="true"
            android:gravity="center"
            android:text="I"
            android:textColor="@color/format_toggle_text"
            android:textSize="18sp"
            android:textStyle="italic" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="12dp"
            android:background="@color/border_subtle" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_color_black"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:contentDescription="@string/notes_color_black"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_bg"
                        android:backgroundTint="#0F172A" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_color_red"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:contentDescription="@string/notes_color_red"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_bg"
                        android:backgroundTint="#EF4444" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_color_blue"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:contentDescription="@string/notes_color_blue"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_bg"
                        android:backgroundTint="#3B82F6" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_color_green"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:contentDescription="@string/notes_color_green"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_bg"
                        android:backgroundTint="#10B981" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_color_orange"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:contentDescription="@string/notes_color_orange"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_bg"
                        android:backgroundTint="#F59E0B" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_color_purple"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:contentDescription="@string/notes_color_purple"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_bg"
                        android:backgroundTint="#8B5CF6" />
                </FrameLayout>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
