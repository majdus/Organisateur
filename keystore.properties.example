# Modèle des coordonnées de signature.
#
# Recopier ce fichier en `keystore.properties` à la racine du projet, puis y mettre les vraies
# valeurs. Le fichier réel est ignoré par Git: il porte les mots de passe en clair et ne doit
# jamais quitter la machine.
#
#     cp keystore.properties.example keystore.properties
#
# La clé se crée une seule fois, avec:
#
#     keytool -genkeypair -v \
#       -keystore /home/majdus/keys/organisateur-upload-key.jks \
#       -alias organisateur-upload \
#       -keyalg RSA -keysize 4096 -validity 10000 \
#       -dname "CN=Majdus, O=Organisateur, C=FR"
#
# C'est une clé de *téléversement*: elle prouve à Google que l'envoi vient bien de nous. La clé
# de signature qui atteint les appareils est détenue par Play App Signing. Une clé de
# téléversement perdue se remplace en écrivant au support; à sauvegarder tout de même.

# Chemin absolu du magasin de clés, hors du dépôt.
storeFile=/home/majdus/keys/organisateur-upload-key.jks

# Mot de passe du magasin.
storePassword=

# Nom de la clé à l'intérieur du magasin (le `-alias` de la commande ci-dessus).
keyAlias=organisateur-upload

# Mot de passe de la clé. `keytool` propose de reprendre celui du magasin.
keyPassword=
